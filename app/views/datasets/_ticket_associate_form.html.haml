= form_with url: associate_ticket_dataset_path(@dataset), scope: :dataset, method: :patch, local: true do |form|
  .form-group
    = form.label :ticket_id, "TeamDynamix ticket ID", for: "dataset_ticket_id"
    %p#ticket-id-help Enter the ID of an existing TeamDynamix ticket to associate it with this dataset.
    - if @ticket_association_error.present?
      %p#ticket-id-error.alert.alert-danger(role="alert")
        = @ticket_association_error
    = form.text_field :ticket_id, id: "dataset_ticket_id", value: @ticket_id_input || @dataset.ticket_id, class: "form-control", required: true, inputmode: "numeric", pattern: "[1-9][0-9]*", autofocus: @ticket_association_error.present?, aria: { describedby: @ticket_association_error.present? ? "ticket-id-help ticket-id-error" : "ticket-id-help", invalid: @ticket_association_error.present? ? "true" : nil }
  = form.submit "Associate ticket", class: "btn btn-primary"