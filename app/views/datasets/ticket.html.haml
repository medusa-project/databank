= render 'datasets/brief_record', dataset: @dataset

%h2 Ticket
.row
  %a(href="https://help.uillinois.edu/TDWorkManagement" target="_blank") TeamDynamix Dashboard
.row
  - if @existing_ticket.present?
    %h3
      = link_to "View Ticket #{@dataset.ticket_id} in TeamDynamix", @dataset.ticket_url, target: "_blank", rel: "noopener"
    %h3 Ticket Description
    %p
      = @existing_ticket.description
    - if @ticket_comments.present?
      %h3 Ticket Comments
      - @ticket_comments.each do |comment|
        %p
          = comment.body
  - else
    %p No ticket available for this dataset.
