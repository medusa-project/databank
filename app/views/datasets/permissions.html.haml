= render 'brief_record', dataset:@dataset
.panel-group(id="permissions")
  .panel.panel-default
    .panel-heading(id="permissionsHeading")
      %h4(class="panel-title")
        %a(role="button" data-toggle="collapse" data-parent="#access" href="#permissionsPanel" aria-expanded="false" aria-controls="permissionsPanel" class="accordion-toggle collapsed" )
          %span( class="metadata-label" ) Permissions
    .panel-collapse.collapse.in(id="permissionsPanel" aria-labelledby="permissionsHeading" )
      .panel-body
        %strong Additional Editor Email Addresses:
        =form_tag("/datasets/#{@dataset.key}/update_permissions", method: :post) do
          -@dataset.reviewer_emails.each do |email|
            =hidden_field_tag "reviewer_emails[]", email, id: nil
          -@dataset.editor_emails.each do |email|
            .row
              .col-md-1
                .pull-right
                  %input(type="checkbox" name="editor_emails[]" value="#{email}" checked="checked" aria-label="#{email}")
              .col-md-3
                =email
          %div#newEditorsDiv(aria-live="polite" aria-relevant="additions")
          .row
            .col-md-3.col-md-offset-1
              %label.sr-only(for="newEditor") New editor email address
              %input(type="email" name="newEditor" id="newEditor" class="form-control" placeholder="enter email address then click Add")
            .col-md-2
              %button(type="button" id="addEditorBtn" class= "btn btn-success")
                Add
          .row
            .col-md-3.col-md-offset-6
              %button(type="submit" class="btn btn-primary") Update
