%dialog#google-drive-confirmation{aria: {labelledby: "google-drive-confirmation-title", describedby: "google-drive-selected-details google-drive-copy-notice"}}
  %h2#google-drive-confirmation-title Confirm Google Drive import
  %dl#google-drive-selected-details
    %dt Filename
    %dd#google-drive-selected-name
    %dt Size
    %dd#google-drive-selected-size
  %p#google-drive-copy-notice This creates an independent copy in Illinois Data Bank. Later changes in Google Drive will not update this copy.
  %button.btn.btn-primary#google-drive-confirm{type: "button"} Start import
  %button.btn.btn-default#google-drive-dismiss{type: "button"} Cancel
