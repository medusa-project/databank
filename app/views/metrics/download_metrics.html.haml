%h2 Download Metrics

- current_calendar_year = Metric.current_calendar_year
- current_fiscal_year = Metric.current_fiscal_year
- current_fiscal_label = "FY#{current_fiscal_year.to_s.rjust(2, '0')}"
- first_calendar_year = Metric::FIRST_DOWNLOAD_CALENDAR_YEAR
- first_fiscal_year = Metric::FIRST_DOWNLOAD_FISCAL_YEAR

%a.btn.btn-primary.btn-sm.idb{href: "/admin_metrics.html", data: {testid: "admin-metric-page-link"}}
  %span.glyphicon.glyphicon-arrow-left{"aria-hidden" => "true"}
  = "Back to Curator Metrics Page"

.metrics-section
  %h3 Dataset Downloads

  .indent
    %p Daily download tallies grouped at the dataset level.
    %strong Field Definitions
    %ul
      %li
        %strong dataset_key:
        Unique key that identifies the dataset.
      %li
        %strong doi:
        DOI that identifies the dataset.
      %li
        %strong download_date:
        Download date for the tally row.
      %li
        %strong tally:
        Number of downloads counted on that date for the dataset.

  .metrics-zip-actions
    %a.btn.btn-primary.btn-sm.idb{href: "/metrics/download_zip/dataset_calendar", "aria-label" => "Download all dataset calendar year CSVs as zip"}
      %span.glyphicon.glyphicon-download{"aria-hidden" => "true"}
      Download All Calendar Year CSVs (zip)
    %a.btn.btn-primary.btn-sm.idb{href: "/metrics/download_zip/dataset_fiscal", "aria-label" => "Download all dataset fiscal year CSVs as zip"}
      %span.glyphicon.glyphicon-download{"aria-hidden" => "true"}
      Download All Fiscal Year CSVs (zip)

  %p
    %strong Current Year Files:
  %ul
    %li
      - current_dataset_calendar = Metric.filename_for_year_metric(:dataset_downloads, current_calendar_year, :calendar)
      %a{href: "/#{current_dataset_calendar}",
          data: {testid: "metric-download-dataset-#{current_calendar_year}-calendar"},
          "aria-label" => "Download Dataset Downloads #{current_calendar_year} (Calendar Year)",
          title: "Download Dataset Downloads #{current_calendar_year} (Calendar Year)",
          download: current_dataset_calendar}
        Dataset Downloads #{current_calendar_year} (Calendar Year)
    %li
      - current_dataset_fiscal = Metric.filename_for_year_metric(:dataset_downloads, current_fiscal_year, :fiscal)
      %a{href: "/#{current_dataset_fiscal}",
          data: {testid: "metric-download-dataset-#{current_fiscal_label}-fiscal"},
          "aria-label" => "Download Dataset Downloads #{current_fiscal_label} (Fiscal Year)",
          title: "Download Dataset Downloads #{current_fiscal_label} (Fiscal Year)",
          download: current_dataset_fiscal}
        Dataset Downloads #{current_fiscal_label} (Fiscal Year)

  %p
    %strong Prior Year Files — Calendar Year:
  %ul
    - (first_calendar_year...current_calendar_year).to_a.reverse_each do |year|
      %li
        %a{href: "/metrics/archived/dataset_downloads/#{year}/calendar",
            data: {testid: "metric-download-dataset-#{year}-calendar"},
            download: "dataset_downloads_#{year}.csv"}
          Dataset Downloads #{year} (Calendar Year)

  %p
    %strong Prior Year Files — Fiscal Year:
  %ul
    - (first_fiscal_year...current_fiscal_year).to_a.reverse_each do |fy|
      - fy_label = "FY#{fy.to_s.rjust(2, '0')}"
      %li
        %a{href: "/metrics/archived/dataset_downloads/#{fy_label}/fiscal",
            data: {testid: "metric-download-dataset-#{fy_label}-fiscal"},
            download: "dataset_downloads_#{fy_label}.csv"}
          Dataset Downloads #{fy_label} (Fiscal Year)

.metrics-section
  %h3 Datafile Downloads

  .metrics-zip-actions
    %a.btn.btn-primary.btn-sm.idb{href: "/metrics/download_zip/datafile_calendar", "aria-label" => "Download all datafile calendar year CSVs as zip"}
      %span.glyphicon.glyphicon-download{"aria-hidden" => "true"}
      Download All Calendar Year CSVs (zip)
    %a.btn.btn-primary.btn-sm.idb{href: "/metrics/download_zip/datafile_fiscal", "aria-label" => "Download all datafile fiscal year CSVs as zip"}
      %span.glyphicon.glyphicon-download{"aria-hidden" => "true"}
      Download All Fiscal Year CSVs (zip)

  .indent
    %p Daily download tallies grouped at the datafile level.
    %strong Field Definitions
    %ul
      %li
        %strong file_web_id:
        Unique identifier for the datafile.
      %li
        %strong dataset_key:
        Unique key that identifies the dataset containing the datafile.
      %li
        %strong doi:
        DOI that identifies the dataset.
      %li
        %strong download_date:
        Download date for the tally row.
      %li
        %strong tally:
        Number of downloads counted on that date for the datafile.

  %p
    %strong Current Year Files:
  %ul
    %li
      - current_datafile_calendar = Metric.filename_for_year_metric(:datafile_downloads, current_calendar_year, :calendar)
      %a{href: "/#{current_datafile_calendar}",
          data: {testid: "metric-download-datafile-#{current_calendar_year}-calendar"},
          "aria-label" => "Download Datafile Downloads #{current_calendar_year} (Calendar Year)",
          title: "Download Datafile Downloads #{current_calendar_year} (Calendar Year)",
          download: current_datafile_calendar}
        Datafile Downloads #{current_calendar_year} (Calendar Year)
    %li
      - current_datafile_fiscal = Metric.filename_for_year_metric(:datafile_downloads, current_fiscal_year, :fiscal)
      %a{href: "/#{current_datafile_fiscal}",
          data: {testid: "metric-download-datafile-#{current_fiscal_label}-fiscal"},
          "aria-label" => "Download Datafile Downloads #{current_fiscal_label} (Fiscal Year)",
          title: "Download Datafile Downloads #{current_fiscal_label} (Fiscal Year)",
          download: current_datafile_fiscal}
        Datafile Downloads #{current_fiscal_label} (Fiscal Year)

  %p
    %strong Prior Year Files — Calendar Year:
  %ul
    - (first_calendar_year...current_calendar_year).to_a.reverse_each do |year|
      %li
        %a{href: "/metrics/archived/datafile_downloads/#{year}/calendar",
            data: {testid: "metric-download-datafile-#{year}-calendar"},
            download: "datafile_downloads_#{year}.csv"}
          Datafile Downloads #{year} (Calendar Year)

  %p
    %strong Prior Year Files — Fiscal Year:
  %ul
    - (first_fiscal_year...current_fiscal_year).to_a.reverse_each do |fy|
      - fy_label = "FY#{fy.to_s.rjust(2, '0')}"
      %li
        %a{href: "/metrics/archived/datafile_downloads/#{fy_label}/fiscal",
            data: {testid: "metric-download-datafile-#{fy_label}-fiscal"},
            download: "datafile_downloads_#{fy_label}.csv"}
          Datafile Downloads #{fy_label} (Fiscal Year)
