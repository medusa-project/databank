- refresh_paths = {}
- refresh_paths[:dataset_downloads_csv] = "/metrics/refresh_dataset_downloads_csv"
- refresh_paths[:datafile_downloads_csv] = "/metrics/refresh_datafile_downloads_csv"
- refresh_paths[:datafiles_csv] = "/metrics/refresh_datafiles_csv"
- refresh_paths[:datasets_tsv] = "/metrics/refresh_datasets_tsv"
- refresh_paths[:container_contents_csv] = "/metrics/refresh_container_contents_csv"
- refresh_paths[:funders_csv] = "/metrics/refresh_funders_csv"
- refresh_paths[:related_materials_csv] = "/metrics/refresh_related_materials_csv"
- modified_times = @modified_times || {}
- refresh_status = @refresh_status || {}
- metric_definitions = @metric_definitions || []

%h2 Curator Metrics

- if metric_definitions.empty?
  .alert.alert-warning
    %p.alert-message
      %strong Note:
      Admin metric definitions are not currently configured.

- metric_definitions.each do |definition|
  - metric_key = definition.key
  - metric_label = definition.label
  - download_path = definition.download_path
  - is_json_metric = definition.content_type == "application/json"
  - download_filename = File.basename(download_path.to_s)
  - modified_value = modified_times[metric_key] || "not found"
  - refresh_in_progress = refresh_status[metric_key]
  - refresh_path = refresh_paths[metric_key]
  - columns = definition.columns || []
  - description_blocks = definition.description_blocks || []

  .metrics-border
    %h3
      = metric_label
      - if !refresh_in_progress && download_path.present?
        %a.btn.btn-primary.btn-sm.idb{href: download_path,
                                      "aria-label" => "Download #{metric_label}",
                                      title: "Download #{metric_label}",
                                      download: (is_json_metric ? download_filename : nil)}
          %span.glyphicon.glyphicon-download-alt{"aria-hidden" => "true"}
          %span.sr-only= "Download #{metric_label}"

    %p.inline-block
      Modified:
      = modified_value

    - if current_user && current_user.role == "admin" && definition.refreshable? && refresh_path.present?
      .curator-only.inline-block
        - if refresh_in_progress
          %p.alert.alert-info{role: "status"}
            %strong Refresh in progress.
            Please refresh this page manually to check for an updated status.
        -else  
          %a.btn.btn-success.btn-sm.idb{href: refresh_path}
            %span.glyphicon.glyphicon-refresh{"aria-hidden" => "true"}
            = "Regenerate #{metric_label}"

    - if definition.summary.present?
      .indent
        %p= definition.summary

    - if description_blocks.any?
      .indent
        - description_blocks.each do |block|
          %p= block

    - if columns.any?
      .indent
        %strong Field Definitions
        %ul
          - columns.each do |column|
            - column_name = column[:name] || column["name"]
            - column_description = column[:description] || column["description"]
            %li
              %strong= "#{column_name}:"
              = column_description

